/*
 * V4L2 capture -> RKMPP H264 encode demo
 *
 * Capture NV12 1920x1080 from V4L2 device via MMAP,
 * feed into h264_rkmpp encoder, write H264 elementary stream to file.
 *
 * Supports both single-plane and multi-plane V4L2 capture devices.
 *
 * Usage:
 *   ./v4l2_rkmpp_enc [output.h264] [num_frames]
 *   Defaults: output.h264, 300 frames
 */

#define _DEFAULT_SOURCE
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <cerrno>
#include <fcntl.h>
#include <unistd.h>
#include <ctime>
#include <sys/ioctl.h>
#include <sys/mman.h>
#include <linux/videodev2.h>

#include <iostream>


extern "C" {
#include <libavcodec/avcodec.h>
#include <libavutil/opt.h>
#include <libavutil/imgutils.h>
#include <libavutil/pixdesc.h>
#include <libswscale/swscale.h>
}

#define DEFAULT_DEVICE "/dev/video55"
#define WIDTH        1920
#define HEIGHT       1080
#define PIX_FMT_V4L2 V4L2_PIX_FMT_NV12
#define NUM_BUFS     4
#define FMT_NUM_PLANES 1

/* av_err2str_c macro does not work in C++, use a helper function instead */
static char err_buf[AV_ERROR_MAX_STRING_SIZE] = {};
static const char *av_err2str_c(int errnum) {
    return av_make_error_string(err_buf, AV_ERROR_MAX_STRING_SIZE, errnum);
}

/* ---- V4L2 helpers ---- */

struct v4l2_buf {
    void  *start;
    size_t length;
};

static int g_mplane = 0;  /* 0 = single-plane, 1 = multi-plane */

static int xioctl(int fd, unsigned long request, void *arg)
{
    int r;
    do { r = ioctl(fd, request, arg); } while (r == -1 && errno == EINTR);
    return r;
}

static void v4l2_open(int *fd, const char *device)
{
    *fd = open(device, O_RDWR | O_NONBLOCK);
    if (*fd < 0) {
        fprintf(stderr, "Cannot open %s: %s\n", device, strerror(errno));
        exit(1);
    }
}

static v4l2_buf_type v4l2_init(int fd, int *w, int *h)
{
    struct v4l2_capability cap;
    memset(&cap, 0, sizeof(cap));
    if (xioctl(fd, VIDIOC_QUERYCAP, &cap) < 0) {
        fprintf(stderr, "VIDIOC_QUERYCAP: %s\n", strerror(errno));
        exit(1);
    }

    printf("V4L2: driver=%s card=%s bus=%s capabilities=0x%08x\n",
           cap.driver, cap.card, cap.bus_info, cap.capabilities);

    enum v4l2_buf_type type;
    if (cap.capabilities & V4L2_CAP_VIDEO_CAPTURE_MPLANE) {
        printf("V4L2: using multi-plane capture\n");
        type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
        g_mplane = 1;
    } else if (cap.capabilities & V4L2_CAP_VIDEO_CAPTURE) {
        printf("V4L2: using single-plane capture\n");
        type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
        g_mplane = 0;
    } else {
        fprintf(stderr, "Not a video capture device (capabilities: 0x%08x)\n", cap.capabilities);
        exit(1);
    }

    if (!(cap.capabilities & V4L2_CAP_STREAMING)) {
        fprintf(stderr, "Device does not support streaming\n");
        exit(1);
    }

    if (g_mplane) {
        struct v4l2_format fmt;
        memset(&fmt, 0, sizeof(fmt));
        fmt.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
        fmt.fmt.pix_mp.width       = WIDTH;
        fmt.fmt.pix_mp.height      = HEIGHT;
        fmt.fmt.pix_mp.pixelformat = PIX_FMT_V4L2;
        fmt.fmt.pix_mp.field       = V4L2_FIELD_NONE;
        fmt.fmt.pix_mp.num_planes  = FMT_NUM_PLANES;
        if (xioctl(fd, VIDIOC_S_FMT, &fmt) < 0) {
            fprintf(stderr, "VIDIOC_S_FMT (mplane): %s\n", strerror(errno));
            exit(1);
        }
        *w = fmt.fmt.pix_mp.width;
        *h = fmt.fmt.pix_mp.height;
        if (fmt.fmt.pix_mp.pixelformat != PIX_FMT_V4L2) {
            fprintf(stderr, "Device did not accept NV12 format\n");
            exit(1);
        }
    } else {
        struct v4l2_format fmt;
        memset(&fmt, 0, sizeof(fmt));
        fmt.type                = V4L2_BUF_TYPE_VIDEO_CAPTURE;
        fmt.fmt.pix.width       = WIDTH;
        fmt.fmt.pix.height      = HEIGHT;
        fmt.fmt.pix.pixelformat = PIX_FMT_V4L2;
        fmt.fmt.pix.field       = V4L2_FIELD_NONE;
        if (xioctl(fd, VIDIOC_S_FMT, &fmt) < 0) {
            fprintf(stderr, "VIDIOC_S_FMT: %s\n", strerror(errno));
            exit(1);
        }
        *w = fmt.fmt.pix.width;
        *h = fmt.fmt.pix.height;
        if (fmt.fmt.pix.pixelformat != PIX_FMT_V4L2) {
            fprintf(stderr, "Device did not accept NV12 format\n");
            exit(1);
        }
    }

    printf("V4L2: %dx%d NV12\n", *w, *h);

    /* Set frame rate */
    struct v4l2_streamparm parm;
    memset(&parm, 0, sizeof(parm));
    if (g_mplane)
        parm.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
    else
        parm.type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
    parm.parm.capture.timeperframe.numerator   = 1;
    parm.parm.capture.timeperframe.denominator = 30;
    xioctl(fd, VIDIOC_S_PARM, &parm);

    return type;
}

static void v4l2_mmap(int fd, struct v4l2_buf *bufs, int *n_bufs, enum v4l2_buf_type type)
{
    struct v4l2_requestbuffers req;
    memset(&req, 0, sizeof(req));
    req.count  = NUM_BUFS;
    req.type   = type;
    req.memory = V4L2_MEMORY_MMAP;
    if (xioctl(fd, VIDIOC_REQBUFS, &req) < 0) {
        fprintf(stderr, "VIDIOC_REQBUFS: %s\n", strerror(errno));
        exit(1);
    }
    if (req.count < 2) {
        fprintf(stderr, "Insufficient buffer memory\n");
        exit(1);
    }
    *n_bufs = req.count;

    for (unsigned i = 0; i < req.count; i++) {
        struct v4l2_plane planes[FMT_NUM_PLANES];
        struct v4l2_buffer buf;
        memset(&buf, 0, sizeof(buf));
        buf.type   = type;
        buf.memory = V4L2_MEMORY_MMAP;
        buf.index  = i;
        if (g_mplane) {
            buf.m.planes = planes;
            buf.length   = FMT_NUM_PLANES;
        }

        if (xioctl(fd, VIDIOC_QUERYBUF, &buf) < 0) {
            fprintf(stderr, "VIDIOC_QUERYBUF: %s\n", strerror(errno));
            exit(1);
        }

        if (g_mplane) {
            bufs[i].length = buf.m.planes[0].length;
            bufs[i].start  = mmap(nullptr, buf.m.planes[0].length,
                                  PROT_READ | PROT_WRITE, MAP_SHARED,
                                  fd, buf.m.planes[0].m.mem_offset);
        } else {
            bufs[i].length = buf.length;
            bufs[i].start  = mmap(nullptr, buf.length,
                                  PROT_READ | PROT_WRITE, MAP_SHARED,
                                  fd, buf.m.offset);
        }

        if (bufs[i].start == MAP_FAILED) {
            fprintf(stderr, "mmap: %s\n", strerror(errno));
            exit(1);
        }
    }
}

static void v4l2_start(int fd, enum v4l2_buf_type type)
{
    for (int i = 0; i < NUM_BUFS; i++) {
        struct v4l2_plane planes[FMT_NUM_PLANES];
        struct v4l2_buffer buf;
        memset(&buf, 0, sizeof(buf));
        buf.type   = type;
        buf.memory = V4L2_MEMORY_MMAP;
        buf.index  = i;
        if (g_mplane) {
            buf.m.planes = planes;
            buf.length   = FMT_NUM_PLANES;
        }
        if (xioctl(fd, VIDIOC_QBUF, &buf) < 0) {
            fprintf(stderr, "VIDIOC_QBUF: %s\n", strerror(errno));
            exit(1);
        }
    }
    if (xioctl(fd, VIDIOC_STREAMON, &type) < 0) {
        fprintf(stderr, "VIDIOC_STREAMON: %s\n", strerror(errno));
        exit(1);
    }
    printf("V4L2: streaming started\n");
}

static void v4l2_stop(int fd, enum v4l2_buf_type type)
{
    xioctl(fd, VIDIOC_STREAMOFF, &type);
}

static void v4l2_cleanup(int fd, struct v4l2_buf *bufs, int n_bufs)
{
    for (int i = 0; i < n_bufs; i++)
        munmap(bufs[i].start, bufs[i].length);
    close(fd);
}

/* ---- Encode helper ---- */

static void encode(AVCodecContext *enc_ctx, AVFrame *frame,
                   AVPacket *pkt, FILE *outfile)
{
    int ret = avcodec_send_frame(enc_ctx, frame);
    if (ret < 0) {
        fprintf(stderr, "avcodec_send_frame: %s\n", av_err2str_c(ret));
        return;
    }
    while (ret >= 0) {
        ret = avcodec_receive_packet(enc_ctx, pkt);
        if (ret == AVERROR(EAGAIN) || ret == AVERROR_EOF)
            return;
        if (ret < 0) {
            fprintf(stderr, "avcodec_receive_packet: %s\n", av_err2str_c(ret));
            return;
        }
        fwrite(pkt->data, 1, pkt->size, outfile);
        av_packet_unref(pkt);
    }
}

/* ---- Fill NV12 frame from V4L2 buffer ---- */

static void fill_nv12_frame(AVFrame *frame, const void *data, int width, int height)
{
    int y_size = width * height;

    memcpy(frame->data[0], data, y_size);
    memcpy(frame->data[1], static_cast<const uint8_t *>(data) + y_size, y_size / 2);
}

/* ---- Main ---- */

int main(int argc, char **argv)
{
    std::cout << "Usage: v4l2_rkmpp_enc [device] [output.h264] [num_frames]\n";
    const char *device     = (argc > 1) ? argv[1] : DEFAULT_DEVICE;
    const char *outfile    = (argc > 2) ? argv[2] : "output.h264";
    int max_frames         = (argc > 3) ? atoi(argv[3]) : 300;

    printf("Device: %s, Output: %s, Frames: %d\n", device, outfile, max_frames);

    int vfd, n_bufs, cap_w, cap_h;
    struct v4l2_buf bufs[NUM_BUFS];
    enum v4l2_buf_type buf_type;

    /* 1. V4L2 init */
    v4l2_open(&vfd, device);
    buf_type = v4l2_init(vfd, &cap_w, &cap_h);
    v4l2_mmap(vfd, bufs, &n_bufs, buf_type);
    v4l2_start(vfd, buf_type);

    /* 2. Encoder init — try h264_rkmpp first, fallback to libx264 */
    const AVCodec *codec = avcodec_find_encoder_by_name("h264_rkmpp");
    if (!codec) {
        fprintf(stderr, "h264_rkmpp not found, trying libx264\n");
        codec = avcodec_find_encoder_by_name("libx264");
    }
    if (!codec) {
        fprintf(stderr, "No H264 encoder found\n");
        exit(1);
    }
    printf("Using encoder: %s\n", codec->name);

    AVCodecContext *enc_ctx = avcodec_alloc_context3(codec);
    if (!enc_ctx) {
        fprintf(stderr, "Could not allocate encoder context\n");
        exit(1);
    }

    enc_ctx->bit_rate  = 4 * 1000 * 1000;   /* 4 Mbps */
    enc_ctx->width     = cap_w;
    enc_ctx->height    = cap_h;
    enc_ctx->time_base = (AVRational){ 1, 30 };
    enc_ctx->framerate = (AVRational){ 30, 1 };
    enc_ctx->gop_size  = 30;
    enc_ctx->pix_fmt   = AV_PIX_FMT_NV12;

    /* RKMPP-specific options */
    if (strcmp(codec->name, "h264_rkmpp") == 0) {
        av_opt_set(enc_ctx->priv_data, "rc_mode", "CBR", 0);
    } else {
        /* libx264 options */
        enc_ctx->pix_fmt = AV_PIX_FMT_YUV420P;
        av_opt_set(enc_ctx->priv_data, "preset", "ultrafast", 0);
        av_opt_set(enc_ctx->priv_data, "tune",   "zerolatency", 0);
    }

    int ret = avcodec_open2(enc_ctx, codec, nullptr);
    if (ret < 0) {
        fprintf(stderr, "Could not open codec: %s\n", av_err2str_c(ret));
        exit(1);
    }

    /* 3. Prepare AVFrame */
    AVFrame *frame = av_frame_alloc();
    frame->format = enc_ctx->pix_fmt;
    frame->width  = cap_w;
    frame->height = cap_h;
    ret = av_frame_get_buffer(frame, 0);
    if (ret < 0) {
        fprintf(stderr, "Could not allocate frame: %s\n", av_err2str_c(ret));
        exit(1);
    }

    AVPacket *pkt = av_packet_alloc();

    /* For NV12->YUV420P conversion when using libx264 */
    SwsContext *sws = nullptr;
    AVFrame *frame_yuv = nullptr;
    if (enc_ctx->pix_fmt == AV_PIX_FMT_YUV420P) {
        sws = sws_getContext(cap_w, cap_h, AV_PIX_FMT_NV12,
                             cap_w, cap_h, AV_PIX_FMT_YUV420P,
                             0, nullptr, nullptr, nullptr);
        frame_yuv = av_frame_alloc();
        frame_yuv->format = AV_PIX_FMT_YUV420P;
        frame_yuv->width  = cap_w;
        frame_yuv->height = cap_h;
        av_frame_get_buffer(frame_yuv, 0);
    }

    /* 4. Open output file */
    FILE *fp = fopen(outfile, "wb");
    if (!fp) {
        fprintf(stderr, "Cannot open %s: %s\n", outfile, strerror(errno));
        exit(1);
    }
    printf("Writing H264 to %s\n", outfile);

    /* 5. Capture + Encode loop */
    int frame_cnt = 0;
    int64_t pts   = 0;

    printf("Capturing %d frames...\n", max_frames);

    while (frame_cnt < max_frames) {
        struct v4l2_plane planes[FMT_NUM_PLANES];
        struct v4l2_buffer vbuf;
        memset(&vbuf, 0, sizeof(vbuf));
        vbuf.type   = buf_type;
        vbuf.memory = V4L2_MEMORY_MMAP;
        if (g_mplane) {
            vbuf.m.planes = planes;
            vbuf.length   = FMT_NUM_PLANES;
        }

        if (xioctl(vfd, VIDIOC_DQBUF, &vbuf) < 0) {
            if (errno == EAGAIN) {
                usleep(1000);
                continue;
            }
            fprintf(stderr, "VIDIOC_DQBUF: %s\n", strerror(errno));
            break;
        }

        /* Fill AVFrame from V4L2 buffer */
        if (enc_ctx->pix_fmt == AV_PIX_FMT_NV12) {
            av_frame_make_writable(frame);
            fill_nv12_frame(frame, bufs[vbuf.index].start, cap_w, cap_h);
            frame->pts = pts++;
            encode(enc_ctx, frame, pkt, fp);
        } else {
            av_frame_make_writable(frame_yuv);
            frame->data[0] = static_cast<uint8_t *>(bufs[vbuf.index].start);
            frame->data[1] = static_cast<uint8_t *>(bufs[vbuf.index].start) + cap_w * cap_h;
            frame->linesize[0] = cap_w;
            frame->linesize[1] = cap_w;
            sws_scale(sws,
                      const_cast<const uint8_t *const *>(frame->data), frame->linesize,
                      0, cap_h,
                      frame_yuv->data, frame_yuv->linesize);
            frame_yuv->pts = pts++;
            encode(enc_ctx, frame_yuv, pkt, fp);
        }

        /* Re-queue the buffer */
        if (xioctl(vfd, VIDIOC_QBUF, &vbuf) < 0) {
            fprintf(stderr, "VIDIOC_QBUF: %s\n", strerror(errno));
            break;
        }

        frame_cnt++;
        if (frame_cnt % 30 == 0)
            printf("  encoded %d frames\n", frame_cnt);
    }

    /* 6. Flush encoder */
    printf("Flushing encoder...\n");
    encode(enc_ctx, nullptr, pkt, fp);

    /* 7. Cleanup */
    fclose(fp);
    v4l2_stop(vfd, buf_type);
    v4l2_cleanup(vfd, bufs, n_bufs);

    if (sws)        sws_freeContext(sws);
    if (frame_yuv)  av_frame_free(&frame_yuv);
    av_frame_free(&frame);
    av_packet_free(&pkt);
    avcodec_free_context(&enc_ctx);

    printf("Done. %d frames encoded to %s\n", frame_cnt, outfile);
    return 0;
}
